OURBOX_PLATFORM_PROFILE=demo-apps
OURBOX_PLATFORM_PROFILE_KIND=demo-apps
OURBOX_PLATFORM_PROFILE_DESCRIPTION=Temporary upstream-owned runnable app baseline while the full tenant-path gateway stack is still being implemented.
OURBOX_PLATFORM_ROUTE_MODEL=demo-subdomains
OURBOX_PLATFORM_EXPECTS_BOX_HOST=1
OURBOX_PLATFORM_DEFAULT_TLS_MODE=lan-http
OURBOX_PLATFORM_DEFAULT_INGRESS_CLASS=traefik
OURBOX_PLATFORM_DEFAULT_STORAGE_CLASS=local-path
OURBOX_PLATFORM_REQUIRED_INPUTS=BOX_HOST
OURBOX_PLATFORM_OPTIONAL_INPUTS=TLS_MODE,INGRESS_CLASS,STORAGE_CLASS
