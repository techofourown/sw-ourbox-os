# Optional curated stable defaults for the release-driven install-defaults
# promotion workflow.
#
# Leave these empty to promote the already-published versioned install-defaults
# artifact into the moving `stable` tag without rebuilding it.
#
# Set one or more values to rebuild `install-defaults:stable` from the checked-
# out release tag with curated digest-pinned OS_DEFAULT_REF values.
#
# Example:
# MATCHBOX_OS_DEFAULT_REF_OVERRIDE=ghcr.io/techofourown/ourbox-matchbox-os@sha256:...

MATCHBOX_OS_DEFAULT_REF_OVERRIDE=
WOODBOX_OS_DEFAULT_REF_OVERRIDE=
TINDERBOX_OS_DEFAULT_REF_OVERRIDE=
