{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OurBox Application Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "catalog_id",
    "catalog_name",
    "catalog_description",
    "default_app_ids",
    "apps"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "kind": {
      "const": "ourbox-application-catalog"
    },
    "catalog_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "catalog_name": {
      "type": "string",
      "minLength": 1
    },
    "catalog_description": {
      "type": "string",
      "minLength": 1
    },
    "default_app_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "apps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/app"
      }
    }
  },
  "$defs": {
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "app_uid",
        "display_name",
        "description",
        "service_name",
        "service_port",
        "host_template",
        "expected_status",
        "body_marker",
        "route_description",
        "image_names"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "app_uid": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "renderer": {
          "type": "string",
          "minLength": 1
        },
        "service_name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "service_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "host_template": {
          "type": "string",
          "pattern": "\\{box_host\\}"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "expected_status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "body_marker": {
          "type": "string",
          "minLength": 1
        },
        "route_description": {
          "type": "string",
          "minLength": 1
        },
        "default_backend": {
          "type": "boolean"
        },
        "image_names": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
