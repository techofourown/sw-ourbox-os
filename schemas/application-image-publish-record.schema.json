{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OurBox Application Image Publish Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "app_id",
    "display_name",
    "image_repo",
    "default_tag",
    "pinned_ref",
    "digest",
    "github_sha",
    "github_run_id",
    "github_run_attempt"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "kind": {
      "const": "ourbox-application-image-publish-record"
    },
    "app_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "image_repo": {
      "type": "string",
      "pattern": "^ghcr\\.io/.+/.+$"
    },
    "default_tag": {
      "type": "string",
      "minLength": 1
    },
    "pinned_ref": {
      "type": "string",
      "pattern": "^ghcr\\.io/.+/.+@sha256:[0-9a-f]{64}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "github_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "github_run_id": {
      "type": "string",
      "minLength": 1
    },
    "github_run_attempt": {
      "type": "string",
      "minLength": 1
    }
  }
}
