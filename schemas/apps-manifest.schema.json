{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OurBox Apps Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "collection_id",
    "display_name",
    "apps"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "kind": {
      "const": "ourbox-apps-collection"
    },
    "collection_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "apps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/app"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "app_id",
        "display_name",
        "source_path",
        "image_repo",
        "default_tag"
      ],
      "properties": {
        "app_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "image_repo": {
          "type": "string",
          "pattern": "^ghcr\\.io/.+/.+$"
        },
        "default_tag": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
