{
  "schema": 1,
  "kind": "ourbox-application-catalog",
  "catalog_id": "example-catalog",
  "catalog_name": "Example Catalog",
  "catalog_description": "Example catalog showing the minimum route and health metadata required for a first-class OurBox app.",
  "default_app_ids": [
    "example-app"
  ],
  "apps": [
    {
      "id": "example-app",
      "app_uid": "example/example-app",
      "display_name": "Example App",
      "description": "Replace this entry with your real app metadata.",
      "renderer": "static-http",
      "service_name": "example-app",
      "service_port": 80,
      "host_template": "example.{box_host}",
      "path": "/",
      "expected_status": 200,
      "body_marker": "Example App",
      "route_description": "example-app-root",
      "default_backend": false,
      "image_names": [
        "example-app"
      ]
    }
  ]
}
